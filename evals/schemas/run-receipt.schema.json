{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/abstraction-police/run-receipt.schema.json",
  "title": "Immutable Abstraction Police run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "receipt_id",
    "skill_identity",
    "skill_hash",
    "eval_manifest_hash",
    "scanner_version",
    "scanner_hash",
    "model",
    "producer_id",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "run-receipt"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^run-sha256:[0-9a-f]{64}$"
    },
    "skill_identity": {
      "type": "string",
      "pattern": "^skill-sha256:[0-9a-f]{64}$"
    },
    "skill_hash": {
      "$ref": "#/$defs/sha256"
    },
    "eval_manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "scanner_version": {
      "type": "string",
      "minLength": 1
    },
    "scanner_hash": {
      "$ref": "#/$defs/sha256"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/result_summary"
      }
    },
    "baseline_receipt_id": {
      "type": "string",
      "pattern": "^run-sha256:[0-9a-f]{64}$"
    },
    "declared_changes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/change"
        },
        "scanner": {
          "$ref": "#/$defs/change"
        },
        "eval_manifest": {
          "$ref": "#/$defs/change"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "config",
        "config_hash",
        "comparison_key_fields",
        "comparison_key",
        "intrinsic_key",
        "missing_comparison_fields",
        "promotion_authority",
        "model_policy_hash"
      ],
      "properties": {
        "mode": {
          "enum": [
            "model-assisted",
            "model-independent"
          ]
        },
        "config": {},
        "config_hash": {
          "$ref": "#/$defs/sha256"
        },
        "comparison_key_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model_id",
            "model_revision",
            "backend_fingerprint",
            "reasoning_effort",
            "temperature",
            "seed",
            "toolset_hash",
            "system_prompt_hash",
            "skill_hash",
            "eval_manifest_hash",
            "input_corpus_hash"
          ],
          "properties": {
            "provider": {},
            "model_id": {},
            "model_revision": {},
            "backend_fingerprint": {},
            "reasoning_effort": {},
            "temperature": {},
            "seed": {},
            "toolset_hash": {},
            "system_prompt_hash": {},
            "skill_hash": {},
            "eval_manifest_hash": {},
            "input_corpus_hash": {}
          }
        },
        "comparison_key": {
          "type": "string",
          "pattern": "^model-comparison-sha256:[0-9a-f]{64}$"
        },
        "intrinsic_key": {
          "type": "string",
          "pattern": "^model-intrinsic-sha256:[0-9a-f]{64}$"
        },
        "missing_comparison_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "promotion_authority": {
          "enum": [
            "eligible",
            "inconclusive",
            "model-independent"
          ]
        },
        "model_policy_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "result_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "result_hash",
        "status",
        "deterministic",
        "tests_discovered",
        "tests_passed",
        "tests_failed",
        "regressions",
        "case_ids",
        "subject_sha256"
      ],
      "properties": {
        "suite": {
          "enum": [
            "public",
            "holdout"
          ]
        },
        "result_hash": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error"
          ]
        },
        "deterministic": {
          "type": "boolean"
        },
        "tests_discovered": {
          "type": "integer",
          "minimum": 0
        },
        "tests_passed": {
          "type": "integer",
          "minimum": 0
        },
        "tests_failed": {
          "type": "integer",
          "minimum": 0
        },
        "regressions": {
          "type": "integer",
          "minimum": 0
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "subject_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "public_suite_identity": {
          "$ref": "#/$defs/sha256"
        },
        "external_suite_identity": {
          "$ref": "#/$defs/sha256"
        },
        "eval_manifest_identity": {
          "$ref": "#/$defs/sha256"
        },
        "model_intrinsic_key": {
          "anyOf": [
            {
              "const": "[not-applicable]"
            },
            {
              "type": "string",
              "pattern": "^model-intrinsic-sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "input_corpus_hash": {
          "$ref": "#/$defs/sha256"
        },
        "sealed": {
          "type": "boolean"
        },
        "grader_owned": {
          "type": "boolean"
        },
        "grader_id": {
          "type": "string"
        },
        "candidate_access_ended": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "suite": {
                "const": "holdout"
              }
            }
          },
          "then": {
            "required": [
              "external_suite_identity",
              "eval_manifest_identity",
              "model_intrinsic_key",
              "input_corpus_hash",
              "sealed",
              "grader_owned",
              "grader_id",
              "candidate_access_ended"
            ]
          },
          "else": {
            "required": [
              "public_suite_identity"
            ]
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "reason"
      ],
      "properties": {
        "from": {},
        "to": {},
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
